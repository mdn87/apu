{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lugos.dev/schemas/apu/behavior-registry-candidate-patch-v1.json",
  "title": "APU review-only Lugos Orca behavior registry candidate patch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "proposal_id", "created_at", "target_repository", "base_registry_revision", "evidence", "operations", "requires_review", "apply_authorized"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "lugos.apu.lugos-orca.behavior-registry-candidate-patch"},
    "proposal_id": {"$ref": "#/$defs/hash"},
    "created_at": {"type": "string", "format": "date-time"},
    "target_repository": {"const": "lugos-orca"},
    "base_registry_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orca_commit", "behavior_tree_sha256"],
      "properties": {
        "orca_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "behavior_tree_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supporting_evidence_ids", "counterexample_evidence_ids", "evidence_bundle_sha256"],
      "properties": {
        "supporting_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
        "counterexample_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
        "evidence_bundle_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/add"},
          {"$ref": "#/$defs/replace"},
          {"$ref": "#/$defs/remove"}
        ]
      }
    },
    "requires_review": {"const": true},
    "apply_authorized": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^/behavior/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$"},
    "add": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "value", "value_sha256"],
      "properties": {
        "op": {"const": "add"},
        "path": {"$ref": "#/$defs/path"},
        "value": true,
        "value_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "replace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "prior_value_sha256", "value", "value_sha256"],
      "properties": {
        "op": {"const": "replace"},
        "path": {"$ref": "#/$defs/path"},
        "prior_value_sha256": {"$ref": "#/$defs/hash"},
        "value": true,
        "value_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "remove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "prior_value_sha256"],
      "properties": {
        "op": {"const": "remove"},
        "path": {"$ref": "#/$defs/path"},
        "prior_value_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
